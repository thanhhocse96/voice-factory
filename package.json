{
  "name": "zeroclaw-vbee-automate",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Local-first Gateway Core for ZeroClaw x Vbee TTS automation.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --experimental-sqlite server.js",
    "start": "node --experimental-sqlite server.js",
    "online": "bash scripts/dev-online.sh",
    "offline": "bash scripts/dev-offline.sh",
    "gateway:start": "node scripts/gateway-lifecycle.mjs start",
    "gateway:status": "node scripts/gateway-lifecycle.mjs status",
    "gateway:stop": "node scripts/gateway-lifecycle.mjs stop",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "smoke": "bash scripts/smoke-gateway.sh",
    "smoke:lifecycle": "bash scripts/smoke-lifecycle.sh",
    "test:m2": "node --test gateway/src/**/*.test.js",
    "context:build": "python3 ../context-mapping/cli.py build . --quiet",
    "context:check": "python3 ../context-mapping/cli.py check-consistency ."
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2"
  }
}
